<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>
<!--cint for add G-list-->
<div class="container">
    <div class="row">
        <div class="offset-md-3 col-md-6">
            <h1><%= title %></h1>

            <form class="form" method="post">
                <div class="form-group">
                    <label for="nameTextField">Item Name</label>
                    <input type="text" class="form-control"
                    id="nameTextField"
                    placeholder="Enter Item Name"
                    name="name" required>

                </div>
                <div class="form-group">
                    <label for="categoryTextField">Category Type</label>
                    <input type="text" class="form-control"
                    id="categoryTextField"
                    placeholder="Enter Category Type"
                    name="category" required>
                </div>

                <div class="form-group">
                    <label for="quantityTextField">Quantity Type</label>
                    <input type="text" class="form-control"
                    id="quantityTextField"
                    placeholder="Enter Quantity #"
                    name="quantity" required>

                </div>
                <div class="form-group">
                    <label for="notesTextArea">Notes</label>
                    <textarea type="text" class="form-control"
                    id="notesTextArea"
                    placeholder="Enter Notes"
                    name="notes" required></textarea>

                </div>

                 <div class="form-group">
                    <label for="priceTextField">Price</label>
                    <input type="text" class="form-control"
                    id="priceTextField"
                    placeholder="Enter Price $"
                    name="price" required>

                </div>
                <br>
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-edit"></i>Sunmit
                </button>
                
                <a href="/Glist" class="btn btn-danger">
                    <i class="fas fa-undo"></i> Cancel
                </a>

            </form>
        </div>
    </div>
    
</div>
<%- include('../partials/footer.ejs') %>
